using UnityEngine;

public class PausePopUpTrigger : MonoBehaviour
{
    [Header("Popup Settings")]
    [TextArea(3, 8)]
    [SerializeField] private string message = "Tutorial message goes here...";
    [SerializeField] private bool triggerOnce = true;

    private bool hasTriggered;

    private PausePopupUI popup;

    private void Start()
    {
        // Finds the popup in the scene (you have exactly one)
        popup = FindObjectOfType<PausePopupUI>();

        if (popup == null)
            Debug.LogError("PausePopupUI not found in the scene. Add it to your PausePopupPanel.");
    }

    private void OnTriggerEnter(Collider other)
    {
        if (!other.CompareTag("Player")) return;
        if (triggerOnce && hasTriggered) return;

        hasTriggered = true;

        if (popup != null)
            popup.Show(message);
    }
}
